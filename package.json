{
  "name": "streamer-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app for streamers with unified chat and automations",
  "author": {
    "name": "Paulo Manrique",
    "email": "paulo@manriq.dev"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json --watch",
    "dev:app": "wait-on tcp:127.0.0.1:5174 dist/main/index.js dist/preload/index.cjs && electron dist/main/index.js",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "clean:release": "node -e \"require('node:fs').rmSync('release', { recursive: true, force: true })\"",
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron dist/main/index.js",
    "package": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml",
    "package:mac": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --mac",
    "package:win": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --win",
    "package:linux": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --linux",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "validate:ipc": "tsx scripts/validate-ipc-sync.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@legendapp/list": "^3.3.8",
    "@nekiro/kick-api": "^3.0.1",
    "@sefinek/google-tts-api": "^2.1.15",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "googleapis": "^176.0.0",
    "music-metadata": "^11.15.0",
    "obs-websocket-js": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tiktok-live-connector": "^2.4.4",
    "tmi.js": "^1.8.5",
    "ws": "^8.21.3",
    "youtubei.js": "^18.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "google-auth-library": "10.5.0"
  }
}
